# ============================================================
# DESEO — Variables de entorno (backend / serverless)
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` NO se versiona (ver .gitignore).
# ============================================================

# --- Clerk (autenticación) ---
# La publishable key es pública (va al cliente). La secret key es SOLO backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXX
# Clerk: URL del emisor (frontend API). Ej: https://<tu-app>.clerk.accounts.dev
CLERK_ISSUER=https://merry-jay-11.clerk.accounts.dev
# IDs de usuario Clerk con rol admin (separados por coma).
ADMIN_USER_IDS=

# --- Bold (pagos) ---
BOLD_API_KEY=TU_BOLD_API_KEY
BOLD_SECRET_KEY=TU_BOLD_SECRET_KEY
BOLD_WEBHOOK_SECRET=TU_BOLD_WEBHOOK_SECRET

# --- Gemini (IA) ---
# Debe usarse SOLO desde el backend. No exponer al cliente.
GEMINI_API_KEY=TU_GEMINI_API_KEY

# --- Firebase Admin (backend con privilegios) ---
# Descarga el service account desde Firebase > Configuración > Cuentas de servicio.
FIREBASE_PROJECT_ID=parcero-6b971
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXX@parcero-6b971.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE\n-----END PRIVATE KEY-----\n"

# --- Remitentes permitidos (para validar el token Clerk en el backend) ---
ALLOWED_ORIGINS=https://simon990520.github.io,http://localhost:3000,http://localhost:5173
